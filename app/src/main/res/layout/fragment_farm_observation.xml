<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.screens.newui.farmdetails.fragments.FarmObservationFragment">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/_600sdp"
            android:orientation="vertical" >

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="@dimen/_260sdp"
                android:layout_margin="@dimen/_10sdp"
                app:cardCornerRadius="@dimen/_10sdp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/gradient_not_rounded_bg"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/temperatureLayout"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="3"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginStart="24dp"
                            android:layout_weight="4"
                            android:gravity="center_vertical"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/timestampTV"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="13 February 2025 | 14:00"
                                android:textColor="@color/white"
                                android:textSize="@dimen/_11sdp" />

                            <TextView
                                android:id="@+id/temperatureTextView"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="22°C"
                                android:textColor="@color/white"
                                android:textSize="@dimen/_16sdp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/weatherTalukaTV"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Mumbai"
                                android:textColor="@color/white"
                                android:textSize="@dimen/_12sdp" />

                        </LinearLayout>

                        <ImageView
                            android:id="@+id/imageView4"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:layout_weight="6"
                            android:padding="@dimen/_10sdp"
                            app:srcCompat="@drawable/weather_ic" />
                    </LinearLayout>

                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_460sdp"
                        android:layout_marginHorizontal="@dimen/_20sdp"
                        android:layout_marginBottom="@dimen/_10sdp"
                        android:layout_weight="5"
                        app:cardCornerRadius="@dimen/_15sdp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/_80sdp"
                                android:orientation="horizontal"
                                android:paddingTop="@dimen/_10sdp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:layout_margin="@dimen/_2sdp"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <ImageView
                                        android:id="@+id/imageView5"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:layout_marginTop="@dimen/_1sdp"
                                        android:layout_weight="3"
                                        app:srcCompat="@drawable/rain_ic" />

                                    <TextView
                                        android:id="@+id/textView12"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:layout_weight="3"
                                        android:gravity="center"
                                        android:text="@string/rain"
                                        android:textSize="@dimen/_11sdp" />

                                    <TextView
                                        android:id="@+id/rainTextView"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:layout_weight="2"
                                        android:gravity="center"
                                        android:text="73%"
                                        android:textSize="@dimen/_16sdp"
                                        android:textStyle="bold" />
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:layout_margin="@dimen/_2sdp"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <ImageView
                                        android:id="@+id/imageView8"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:layout_marginTop="@dimen/_1sdp"
                                        android:layout_weight="3"
                                        app:srcCompat="@drawable/humidity_ic" />

                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:layout_weight="3"
                                        android:gravity="center"
                                        android:text="@string/humidity"
                                        android:textSize="@dimen/_11sdp" />

                                    <TextView
                                        android:id="@+id/humidityTextView"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:layout_weight="2"
                                        android:gravity="center"
                                        android:text="61%"
                                        android:textSize="@dimen/_16sdp"
                                        android:textStyle="bold" />
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:layout_margin="@dimen/_2sdp"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <ImageView
                                        android:id="@+id/imageView9"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:layout_marginTop="@dimen/_1sdp"
                                        android:layout_weight="3"
                                        app:srcCompat="@drawable/wind_ic" />

                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:layout_weight="3"
                                        android:gravity="center"
                                        android:text="@string/wind"
                                        android:textSize="@dimen/_11sdp" />

                                    <TextView
                                        android:id="@+id/windTextView"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:layout_weight="2"
                                        android:gravity="center"
                                        android:text="7 km/h"
                                        android:textSize="@dimen/_16sdp"
                                        android:textStyle="bold" />
                                </LinearLayout>
                            </LinearLayout>

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/_80sdp"
                                android:layout_marginHorizontal="@dimen/_12sdp"
                                android:layout_marginBottom="@dimen/_2sdp"
                                app:cardBackgroundColor="#FFF8F8"
                                app:cardCornerRadius="@dimen/_8sdp"
                                app:cardElevation="@dimen/_1sdp"
                                app:strokeColor="#F1CACA"
                                app:strokeWidth="@dimen/_1sdp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal">

                                    <!-- Red left indicator -->
                                    <View
                                        android:layout_width="@dimen/_3sdp"
                                        android:layout_height="match_parent"
                                        android:background="#E53935" />

                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:orientation="vertical"
                                        android:paddingStart="@dimen/_10sdp"
                                        android:paddingTop="@dimen/_8sdp"
                                        android:paddingEnd="@dimen/_10sdp"
                                        android:paddingBottom="@dimen/_9sdp">

                                        <!-- Top Row -->
                                        <LinearLayout
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:gravity="center_vertical"
                                            android:orientation="horizontal">

                                            <!-- Alert icon -->
                                            <ImageView
                                                android:layout_width="@dimen/_16sdp"
                                                android:layout_height="@dimen/_16sdp"
                                                android:contentDescription="Alert"
                                                android:src="@drawable/alert_ic" />

                                            <!-- Alert Type -->
                                            <TextView
                                                android:id="@+id/tvAlertType"
                                                android:layout_width="0dp"
                                                android:layout_height="wrap_content"
                                                android:layout_marginStart="@dimen/_5sdp"
                                                android:layout_weight="1"
                                                android:letterSpacing="0.08"
                                                android:text="SEVERE ALERT"
                                                android:textColor="#C62828"
                                                android:textSize="@dimen/_8sdp"
                                                android:textStyle="bold" />

                                            <!-- Validity -->
                                            <TextView
                                                android:id="@+id/tvValidity"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:text="Valid: Next 24 Hours"
                                                android:textColor="#666666"
                                                android:textSize="@dimen/_8sdp" />

                                        </LinearLayout>

                                        <!-- Title -->
                                        <TextView
                                            android:id="@+id/tvTitle"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="@dimen/_4sdp"
                                            android:text="Extremely Heavy Rainfall Expected"
                                            android:textColor="#252525"
                                            android:textSize="@dimen/_10sdp"
                                            android:textStyle="bold" />

                                        <!-- Description -->
                                        <TextView
                                            android:id="@+id/tvDescription"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="@dimen/_1sdp"
                                            android:text="Clear drainage channels immediately to prevent waterlogging."
                                            android:textColor="#555555"
                                            android:textSize="@dimen/_9sdp" />

                                    </LinearLayout>

                                </LinearLayout>

                            </com.google.android.material.card.MaterialCardView>

                        </LinearLayout>

                    </androidx.cardview.widget.CardView>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/weatherFarmRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                tools:listitem="@layout/item_view_farm_weather"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>